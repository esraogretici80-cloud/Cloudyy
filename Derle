name: Android APK Derle

on:
  push:
    branches: [ "main", "master" ]
  workflow_dispatch: # GitHub üzerinden manuel olarak tetikleyebilmek için

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Kodu İndir
        uses: actions/checkout@v4

      - name: JDK 17 Kur
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'

      - name: Gradlew Çalıştırma İzni Ver
        run: chmod +x gradlew

      - name: Debug APK Oluştur
        run: ./gradlew assembleDebug

      - name: APK Dosyasını Yükle
        uses: actions/upload-artifact@v4
        with:
          name: app-debug
          path: app/build/outputs/apk/debug/app-debug.apk
